# Talos Engine Input Map Configuration (v1)
# Format: action_name = Key1, Key2, ...

move_left = A, Left
move_right = D, Right
move_up = W, Up
move_down = S, Down
jump = Space
attack = J, Z
interact = E, F
sprint = LeftShift
crouch = LeftControl, C
dash = K, X
reload = R
inventory = Tab, I
pause = Escape, P
ui_accept = Enter, Space
ui_cancel = Escape, Backspace
